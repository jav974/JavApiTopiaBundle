{
  "type": "symfony-bundle",
  "name": "jav/apitopia-bundle",
  "description": "GraphQL APIs made simpler",
  "license": "MIT",
  "keywords": [
    "symfony",
    "api",
    "graphql",
    "relay"
  ],
  "authors": [
    {
      "name": "Jérémy Vienne",
      "email": "jeremyvienne@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "webonyx/graphql-php": "^15.0",
    "ecodev/graphql-upload": "^7.0 || ^8.0",
    "nyholm/psr7": "^1.6",
    "phpdocumentor/reflection-docblock": "^5.3 || ^6.0",
    "symfony/config": "^6.4 || ^7.0 || ^8.0",
    "symfony/console": "^6.4 || ^7.0 || ^8.0",
    "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
    "symfony/finder": "^6.4 || ^7.0 || ^8.0",
    "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
    "symfony/mime": "^6.4 || ^7.0 || ^8.0",
    "symfony/property-access": "^6.4 || ^7.0 || ^8.0",
    "symfony/property-info": "^6.4 || ^7.0 || ^8.0",
    "symfony/psr-http-message-bridge": "^6.4 || ^7.0 || ^8.0",
    "symfony/routing": "^6.4 || ^7.0 || ^8.0",
    "symfony/serializer": "^6.4 || ^7.0 || ^8.0",
    "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
    "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0 || ^13.0",
    "squizlabs/php_codesniffer": "^3.7",
    "phpcompatibility/php-compatibility": "^9.3",
    "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
    "symfony/mercure-bundle": "^0.3.7 || ^0.4 || ^0.5 || ^0.6 || ^0.7",
    "symfony/validator": "^6.4 || ^7.0 || ^8.0",
    "symfony/security-core": "^6.4 || ^7.0 || ^8.0"
  },
  "suggest": {
    "symfony/mercure-bundle": "Required to use GraphQL subscriptions (Subscription attribute)",
    "symfony/validator": "Validates mutation inputs (constraints on input classes)"
  },
  "conflict": {
    "symfony/mercure-bundle": "<0.3.7"
  },
  "autoload": {
    "psr-4": {
      "Jav\\ApiTopiaBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jav\\ApiTopiaBundle\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": false,
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "scripts": {
    "sniffer:php8": "phpcs -p ./src --standard=vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 8.1-",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "phpunit",
    "test:coverage": [
      "@putenv XDEBUG_MODE=coverage",
      "phpunit --coverage-clover coverage.xml"
    ]
  }
}
